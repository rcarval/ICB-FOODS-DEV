        <expression>VALUE({!getRecordLead.RUT__c})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>largoRut</name>
        <dataType>Boolean</dataType>
        <expression>LEN({!RUT}) &lt;&gt; 10</expression>
    </formulas>
    <formulas>
        <name>Rutvalidate</name>
        <dataType>Boolean</dataType>
        <expression>NOT(
  REGEX(
   {!getRecordLead.RUT__c},
    &quot;^[0-9]{1,3}(\\.[0-9]{3})*-[0-9Kk]$&quot;
  )
)</expression>
