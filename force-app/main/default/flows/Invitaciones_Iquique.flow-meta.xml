    <formulas>
        <name>EmailsValuesFormula</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.Email}, &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK({!$Record.Email})), NOT(ISBLANK({!$Record.Email_Invitado_1__c}))), &quot;,&quot;, &quot;&quot;) &amp;
BLANKVALUE({!$Record.Email_Invitado_1__c}, &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK({!$Record.Email_Invitado_1__c})), NOT(ISBLANK({!$Record.Email_Invitado_2__c}))), &quot;,&quot;, &quot;&quot;) &amp;
BLANKVALUE({!$Record.Email_Invitado_2__c}, &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK({!$Record.Email_Invitado_2__c})), NOT(ISBLANK({!$Record.Email_Invitado_3__c}))), &quot;,&quot;, &quot;&quot;) &amp;
BLANKVALUE({!$Record.Email_Invitado_3__c}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>Formula_RutMayor50Millones</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT(ISBLANK({!$Record.RUT__c})),
    VALUE(
        LEFT({!$Record.RUT__c}, FIND(&quot;-&quot;, {!$Record.RUT__c}) - 1)
    ) &gt; 50000000
)</expression>
    </formulas>
    <formulas>
        <name>rut50</name>
        <dataType>String</dataType>
        <expression>{!$Record.RUT__c}</expression>
    </formulas>
    <formulas>
        <name>rutvalido</name>
        <dataType>Boolean</dataType>
        <expression>REGEX({!$Record.RUT__c}, &quot;^50[0-9]{6}-[0-9Kk]{1}$&quot;)</expression>
    </formulas>
