    <decisions>
        <name>Si_esta_vencido_o_hay_q_activar</name>
        <label>Si esta vencido o hay q activar</label>
        <locationX>314</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>nada</defaultConnectorLabel>
        <rules>
            <name>esta_vencido</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Fecha_Vigencia_Hasta__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Hoy</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Desactivar</targetReference>
            </connector>
            <label>esta vencido</label>
        </rules>
        <rules>
            <name>hay_q_activar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Fecha_Vigencia_Desde__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Hoy</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Activar</targetReference>
            </connector>
            <label>hay q activar</label>
        </rules>
    </decisions>
