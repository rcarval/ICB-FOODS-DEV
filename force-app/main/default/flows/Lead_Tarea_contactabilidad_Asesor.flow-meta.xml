    <formulas>
        <name>bodyNotificacion</name>
        <dataType>String</dataType>
        <expression>&quot;Hola &quot; +
&quot;Se ha creado un nuevo lead asignado a ti: &quot; +
	&quot;•	Nombre del Lead: &quot; + {!$Record.Raz_n_Social__c} +
	&quot;•	Empresa / Organización: &quot; + {!$Record.Raz_n_Social__c} +
	&quot;•	Nombre del Contacto: &quot; + {!$Record.Nombre_de_contacto__c} +
	&quot;•	Fecha de ingreso: &quot; + TEXT({!$Record.CreatedDate}) +
	&quot;•	Medio de contacto: &quot; + {!$Record.Telefono__c} + &quot; | &quot; + {!$Record.Email__c} +
	&quot;•	Detalle rápido: &quot; + {!$Record.Proximos_Pasos__c} + 
&quot; Por favor, contacta este lead tan pronto como te sea posible para iniciar la conversación y avanzar con el seguimiento.&quot; +

&quot; Si necesitas alguna información adicional o recursos, comunicate con tu supervisor. &quot; +

&quot; ¡Gracias y éxito con este nuevo contacto! &quot;</expression>
    </formulas>
    <formulas>
        <name>fechaVencimiento</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.CreatedDate}) + 3</expression>
    </formulas>
    <formulas>
        <name>tituloNotificacion</name>
        <dataType>String</dataType>
        <expression>&quot;Nuevo Lead Asignado – Por favor contactar&quot;</expression>
    </formulas>
