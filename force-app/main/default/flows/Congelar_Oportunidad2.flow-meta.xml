    <apiVersion>60.0</apiVersion>
    <decisions>
        <description>Decidir entre las oportunidades, cuales deberian pasar a estado Congelado.</description>
        <name>Aplicar_Estado_Congelado</name>
        <label>Aplicar Estado Congelado?</label>
        <locationX>176</locationX>
        <locationY>252</locationY>
        <defaultConnector>
            <targetReference>Congelar_Oportunidad</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Congelar</defaultConnectorLabel>
        <rules>
            <name>No_Congelar</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CloseDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>FechaValida</elementReference>
                </rightValue>
            </conditions>
            <label>No Congelar</label>
        </rules>
    </decisions>
    <description>Congela las oportunidades cuya Fecha de Cierre haya sido superada por 30 dias</description>
    <environments>Default</environments>
    <formulas>
        <name>FechaValida</name>
        <dataType>Date</dataType>
        <expression>today() - 31</expression>
    </formulas>
