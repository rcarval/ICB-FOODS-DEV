    <description>Este flujo se ejecuta sobre el Lead y tiene como objetivo gestionar el envío de notificaciones cuando ocurre un cambio en el propietario.</description>
    <environments>Default</environments>
    <formulas>
        <name>forT_BodyNotificacion</name>
        <dataType>String</dataType>
        <expression>&quot;Hola &quot; +
&quot;Se ha creado un nuevo lead asignado a ti: &quot; +
	&quot;•Empresa/Organización: &quot; + {!$Record.Company} +
	&quot;•Fecha de ingreso: &quot; + TEXT({!$Record.CreatedDate}) +
	&quot;•Medio de contacto: &quot; + {!$Record.Phone} + &quot; | &quot; +{!$Record.Email} +
&quot; Por favor, contacta este lead tan pronto como te sea posible para iniciar la conversación y avanzar con el seguimiento.&quot; +
&quot; Si necesitas alguna información adicional o recursos, comunícate con tu supervisor. &quot; +
&quot; ¡Gracias y éxito con este nuevo contacto! &quot;</expression>
    </formulas>
    <formulas>
        <name>forT_TituloNotificacion</name>
        <dataType>String</dataType>
        <expression>&quot;Nuevo Lead Asignado – Por favor contactar&quot;</expression>
    </formulas>
