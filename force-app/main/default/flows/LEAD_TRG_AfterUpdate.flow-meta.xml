        <name>Es_Empresa_o_Persona</name>
        <label>¿Es Empresa o Persona?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Es_empresa</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Empresa</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Alerta_finanzas_automaticas</targetReference>
            </connector>
            <label>Es empresa</label>
        </rules>
    </decisions>
    <description>Flow post-conversión de Lead. Actualiza los campos de Account, Contact y Lead que no se mapean automáticamente al convertir un Lead. Envía alerta de email a Finanzas.</description>
    <environments>Default</environments>
    <formulas>
        <description>Concatenación FirstName + LastName</description>
        <name>forT_NombreContacto</name>
        <dataType>String</dataType>
        <expression>{!$Record.FirstName} &amp; &quot; &quot; &amp; {!$Record.LastName}</expression>
    </formulas>
    <formulas>
        <name>forT_Tipificacion</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(
    OR(
      TEXT({!$Record.LeadSource}) = &quot;Web Hablemos&quot;,
      TEXT({!$Record.LeadSource}) = &quot;Web Contactanos&quot;,
      TEXT({!$Record.LeadSource}) = &quot;Catalogo web&quot;,
      TEXT({!$Record.LeadSource}) = &quot;CCC&quot;
    )
  ),
  &quot;Terreno&quot;,
  TEXT({!$Record.LeadSource})
)</expression>
    </formulas>
