<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sucursal_valido_paso_a_prospecto</fullName>
    <active>false</active>
    <errorConditionFormula>ISPICKVAL(Estado__c , &quot;Prospecto&quot;) &amp;&amp;
ISBLANK(TEXT(Sucursal__c))</errorConditionFormula>
    <errorDisplayField>Sucursal__c</errorDisplayField>
    <errorMessage>Completar el campo Sucursal para pasar a Prospecto</errorMessage>
</ValidationRule>
