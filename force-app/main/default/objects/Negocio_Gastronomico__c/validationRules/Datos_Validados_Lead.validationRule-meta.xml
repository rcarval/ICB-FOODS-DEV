<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Datos_Validados_Lead</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
   ISPICKVAL(Estado__c , &quot;Prospecto&quot;),
   NOT(Datos_validados__c)
)</errorConditionFormula>
    <errorMessage>Faltan datos, favor validar usando el botón Validar Datos Para Creación</errorMessage>
</ValidationRule>
