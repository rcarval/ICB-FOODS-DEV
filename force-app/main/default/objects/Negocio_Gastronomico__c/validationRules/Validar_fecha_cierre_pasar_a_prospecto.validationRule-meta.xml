<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validar_fecha_cierre_pasar_a_prospecto</fullName>
    <active>false</active>
    <errorConditionFormula>ISPICKVAL( Estado__c , &quot;Prospecto&quot;) &amp;&amp;  ISBLANK( Fecha_Probable_de_Cierre__c )</errorConditionFormula>
    <errorDisplayField>Fecha_Probable_de_Cierre__c</errorDisplayField>
    <errorMessage>Completar el campo Fecha Probable de Cierre para pasar a Prospecto</errorMessage>
</ValidationRule>
