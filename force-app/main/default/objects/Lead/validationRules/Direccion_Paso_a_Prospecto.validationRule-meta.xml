<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Direccion_Paso_a_Prospecto</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status,&quot;Lead Contactado&quot;) &amp;&amp;
   AND
			(ISBLANK(Direccion__City__s),
				ISBLANK(Direccion__Street__s)
			)</errorConditionFormula>
    <errorDisplayField>Direccion__Street__s</errorDisplayField>
    <errorMessage>Completar el campo Dirección</errorMessage>
</ValidationRule>
