<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BloqueoCamposDireccion</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    (ISNULL(TEXT(Region_Despacho__c)) || ISNULL(Comuna__c) || ISNULL(TEXT(Region__c)) || ISNULL(Comuna_Facturaci_n__c))
)</errorConditionFormula>
    <errorMessage>La comuna y la región debe estar completa</errorMessage>
</ValidationRule>
