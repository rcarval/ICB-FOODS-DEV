<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ValodiModifDomEnvio</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
NOT(ISBLANK( C_digo_de_cliente__c)),
ISCHANGED(ShippingStreet)
)</errorConditionFormula>
    <errorDisplayField>ShippingStreet</errorDisplayField>
    <errorMessage>No se puede modificar la dirección de envio una vez tenga ID SAP</errorMessage>
</ValidationRule>
